{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andreea.volunteerhub",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Volunteer Hub needs calendar access to add events you're attending.",
        "NSCalendarsFullAccessUsageDescription": "Volunteer Hub needs calendar access to add events you're attending.",
        "NSPhotoLibraryUsageDescription": "Volunteer Hub needs access to your photo library to set your profile picture.",
        "NSCameraUsageDescription": "Volunteer Hub needs access to your camera to take a profile picture."
      }
    },
    "android": {
      "package": "com.andreea.volunteerhub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-calendar",
      "expo-image-picker",
      "expo-localization",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.452807959101-6fdpis5acp7bjboo12vlq56oc9o8os8k"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
